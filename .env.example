# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated fallback chain of pydantic-ai model ids. Swap provider without code changes, e.g. groq:..., ollama:...
LLM_MODEL=google:gemini-3.8-flash,google:gemini-3.5-flash-lite,google:gemini-3.1-flash-lite
